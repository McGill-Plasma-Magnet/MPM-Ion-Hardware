		(uuid "03573566-aedc-4207-ba17-c81a6a02be33")
	)
	(text "UV/OV cutoff: TPS3700 in independent-monitor mode drives Q3 -> Q1 high-side PMOS.\nUV: R25 1.74M / R33 100k, R37 10M output feedback adds hysteresis -> OFF 6.3V, ON 7.4V.\nOV: R32 2.15M / R36 100k -> OFF 9.0V. R35 1M pull-up; SW1 manual off, fail-safe via R22.\n1% resistors: UV OFF 6.1-6.5V, ON 7.2-7.7V, OV >= 8.7V. C14 10nF sets ~1ms FET turn-off."
		(exclude_from_sim no)
		(at 133.858 74.93 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "1d3cff11-c2ac-4105-815d-e9d6a8f57c3f")
	)
